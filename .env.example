# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored.
#
# Only the first block is required. Everything below it can instead be entered
# in the app (Settings → Credentials / Security), where it is stored encrypted
# and takes effect without a restart. A value saved in the app overrides the
# same variable here; these are the fallback.

# --- Required ---
# First sign-in password (Settings → Security can replace it).
ATHLETEOS_PASSWORD=change-me
# 32+ random chars, e.g. `openssl rand -base64 48`. Also derives the key that
# encrypts credentials saved in the app: changing it makes those unreadable.
SESSION_SECRET=

# --- Emailed sign-in codes (second factor), optional ---
# Easiest in the app: Settings → Credentials for SMTP, then Settings → Security.
# LOGIN_2FA=off here always wins over the app setting: it is the way back in
# if email breaks while codes are on. Any SMTP provider works, e.g. Brevo
# (smtp-relay.brevo.com:587, SMTP login + SMTP key) or Gmail with an app password.
LOGIN_2FA=
LOGIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Open Wearables ---
# OW_API_BASE defaults to http://192.168.8.222:8000/api/v1 in docker-compose.yml.
# Preferred: an API key from the OW developer portal.
OW_API_KEY=
# Alternative: developer login (used when OW_API_KEY is empty).
OW_EMAIL=
OW_PASSWORD=
# Optional: OW user to link on first start (can also be linked in Settings → Open Wearables).
OW_USER_ID=
ATHLETE_NAME=Athlete

# --- Push reminders (installed PWA) ---
# Keys are generated and stored automatically on first use. Set these only to
# pin your own VAPID keys. The subject is a contact push services may use.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Database ---
POSTGRES_PASSWORD=athleteos
