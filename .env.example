# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored.

# --- Sign-in (required: the app is reachable through the public tunnel) ---
ATHLETEOS_PASSWORD=change-me
# 32+ random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# --- Emailed sign-in codes (second factor), optional ---
# LOGIN_2FA=email makes sign-in need the password plus a 6-digit code sent to
# LOGIN_EMAIL. Leave it unset for password-only. Trusted devices skip the code
# for 30 days. Any SMTP provider works. Gmail/Google Workspace: create an app
# password (Google Account > Security > App passwords; needs 2-Step Verification)
# and use SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your address>,
# SMTP_PASS=<the app password>, SMTP_FROM="AthleteOS <your address>".
LOGIN_2FA=
LOGIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Open Wearables ---
# OW_API_BASE defaults to http://192.168.8.222:8000/api/v1 in docker-compose.yml.
# Preferred: an API key from the OW developer portal.
OW_API_KEY=
# Alternative: developer login (used when OW_API_KEY is empty).
OW_EMAIL=
OW_PASSWORD=
# Optional: OW user to link on first start (can also be linked in Settings → Open Wearables).
OW_USER_ID=
ATHLETE_NAME=Athlete

# --- Push reminders (installed PWA) ---
# Keys are generated and stored automatically on first use. Set these only to
# pin your own VAPID keys. The subject is a contact push services may use.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Database ---
POSTGRES_PASSWORD=athleteos
